PORT=8787
# Where the SQLite file lives (default: ./data)
DATA_DIR=./data
# Token Meta sends on the WhatsApp webhook verification handshake
WEBHOOK_TOKEN=change-me
# Optional: language-model parsing (OpenAI-compatible). Leave empty to use the built-in rule-based parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
